        {
          "info": {
            "name": "Generate a report",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://apis.druva.com/organizations/:organization_id/reports",
            "params": [
              {
                "name": "organization_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Generate a report"
        }
      ]
    }
  ],
