{
  "opencollection": "1.0.0",
  "info": {
    "name": "Druva REST Accounts Authentication API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Exchange API credentials for a bearer access token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://apis.druva.com/token",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "grant_type",
                  "value": ""
                },
                {
                  "name": "scope",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Exchange API credentials for a bearer access token"
        }
      ]
    }
  ],
  "bundled": true
}